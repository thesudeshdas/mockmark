{
  "name": "mockmark",
  "version": "0.2.0",
  "description": "Backendless, private comments and annotations for static HTML mocks.",
  "type": "module",
  "bin": { "mockmark": "./bin/mockmark.js" },
  "exports": {
    "./client": "./public/mockmark/client.js",
    "./client.css": "./public/mockmark/client.css"
  },
  "files": ["bin", "src", "public", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check bin/mockmark.js && node --check src/rules.js"
  },
  "keywords": ["mockups", "annotations", "comments", "design-review", "static-site", "privacy"],
  "author": "Sudesh Das",
  "license": "MIT",
  "engines": { "node": ">=18" }
}
